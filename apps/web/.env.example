# Copiez ce fichier en .env.local (jamais commité).

# PostgreSQL (développement : `docker compose up -d` à la racine du dépôt).
# En production : base de l'hébergeur certifié HDS, avec ?sslmode=require.
DATABASE_URL=postgres://bilanx:bilanx@localhost:5432/bilanx

# Clé maîtresse de chiffrement applicatif (32 octets en base64) :
#   openssl rand -base64 32
# En production : fournie par le KMS de l'hébergeur, jamais dans un fichier.
BILANX_SECRET_KEY=

# URL publique utilisée dans les liens des e-mails.
BILANX_APP_URL=http://localhost:3000

# Facultatif — protège tout le site par identifiant/mot de passe (site de démonstration).
# BILANX_BASIC_AUTH=demo:un-mot-de-passe-long

# Facultatif — uniquement si le site est servi en http hors localhost (déconseillé).
# BILANX_ALLOW_INSECURE_HTTP=true
